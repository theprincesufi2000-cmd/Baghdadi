rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if signedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);

        allow create: if isParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type is string;

        // Sender can soft-delete/react/read their own message.
        // Other participant may only update readBy/reaction.
        allow update: if isParticipant(chatId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'reaction'])
        );

        allow delete: if false;
      }
    }

    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.status in ['preparing', 'ringing'];

      allow read: if signedIn()
        && (request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId);

      allow update: if signedIn()
        && (request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;

      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read, write: if signedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
            || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if signedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
            || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }
    }
  }
}