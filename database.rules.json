{
  "rules": {
    ".read": "auth != null",
    "presence": {
      "$uid": {
        ".read": "auth != null",
        "connections": {
          "$connectionId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['state','last_changed']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'offline')"
          }
        }
      }
    },
    "typing": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true || !newData.exists()"
        }
      }
    }
  }
}
